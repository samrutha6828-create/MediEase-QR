# Environment Configuration Template for MediEase
# Copy this file to .env and configure values for your environment.

# Node Environment (production | development | test)
NODE_ENV=production

# Server Port
PORT=3000

# Database Connection URL (SQLite default or PostgreSQL/MySQL connection string)
DATABASE_URL="file:./prisma/dev.db"

# Public API Base URL (optional: defaults to relative /api in browser)
NEXT_PUBLIC_API_BASE_URL="/api"

# Secret Key for Staff Portal Authorization
STAFF_ACCESS_KEY="your-secure-staff-access-key-here"

# Secret Token for IoT / ESP32 Hardware Webhook Authorization
IOT_DEVICE_SECRET="your-secure-iot-device-secret-here"
